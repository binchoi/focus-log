# Google service account keys. These are live credentials with write access to
# your spreadsheet and they do not expire, so they must never be committed.
# The *.example.json template is deliberately allowed through.
service-account*.json
*-service-account.json
*credentials*.json
!*.example.json

.DS_Store

# EPCC planning scratch for the Wear OS module (working notes, not shipped).
EPCC_PLAN_WEAR.md

# Wear OS / Android build artifacts (focus-log-wear/).
focus-log-wear/.gradle/
focus-log-wear/**/build/
focus-log-wear/local.properties
focus-log-wear/.idea/
focus-log-wear/.kotlin/
*.apk
*.aab
.cxx/

# The real embedded credential + spreadsheet id. Never commit it; the
# *.example.json template is committed instead.
focus-log-wear/wear/src/main/assets/focus-config.json
